{
  "name": "content-classifier",
  "version": "0.1.0",
  "description": "Policy-driven LLM classification of files and conversations through a standalone executable.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit",
    "build": "bun --no-env-file scripts/build.ts",
    "format": "prettier --write src scripts test",
    "format:check": "prettier --check src scripts test"
  },
  "dependencies": {
    "openai": "7.10.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
